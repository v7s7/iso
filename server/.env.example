# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4100
# Only needed when the browser loads the app from a DIFFERENT origin than the
# API. In the normal single-port deployment the server serves public/ itself,
# so requests are same-origin and this can stay as-is.
CLIENT_URL=http://10.27.17.20:4100

# ─── LDAP / Active Directory ──────────────────────────────────────────────────
# Same directory docTracking authenticates against. Leave LDAP_URL blank to run
# the site on local accounts only (the seeded test users still work).
LDAP_URL=ldap://10.27.16.5
LDAP_BASE_DN=DC=swd,DC=local
LDAP_DEFAULT_UPN=swd.bh
LDAP_ALT_UPN=swd.local
LDAP_NETBIOS=SWD

# Service account used to BROWSE the directory (the "استيراد من Active Directory"
# screen). Read-only is enough — no permission beyond Read on the user objects.
# Use a DEDICATED account, not a person's: this file stores the password in
# plain text, so whatever it can do, anyone who reads this file can do.
#
# LDAP_BIND_DN takes a username, a UPN (user@swd.bh), DOMAIN\user, or a full
# distinguished name (CN=svc,OU=...,DC=...) — a bare username is expanded the
# same way the login screen expands one.
#
# ALWAYS put the password in DOUBLE QUOTES. A "#" starts a comment, so an
# unquoted Pa55word### arrives as "Pa55word" and the bind fails looking exactly
# like a wrong password. Quotes also preserve trailing spaces.
#     LDAP_BIND_PASSWORD="Pa55word###"
# `npm run check-env` refuses to pass if it spots an unquoted # in any value.
#
# Leave both blank to disable browsing; sign-in against AD still works without it.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_min_64_chars
JWT_EXPIRES_IN=8h

# ─── مدير النظام override ─────────────────────────────────────────────────────
# Comma-separated usernames or emails that are ALWAYS مدير النظام, whatever the
# users table says. This is the lockout failsafe — no screen in the app can
# remove it, which is the point.
SUPER_ADMIN_USERS=a.alkubaesy

# OPTIONAL, and OFF by default. Set it to a department prefix to make everyone
# in that department مدير النظام — the rule docTracking uses, on the reasoning
# that IT is a team and a permission only one person holds stops working the
# week he is on leave.
#
# Leave it BLANK unless the named department really is the system-administration
# team. In the seeded data "IT" is قسم الموارد والمعلومات — a service department
# full of ordinary staff — so setting it here would hand مدير النظام to every one
# of them and quietly promote them to the organisation-wide view as well.
ADMIN_DEPT_PREFIX=

# ─── Data ─────────────────────────────────────────────────────────────────────
# The folder that holds this deployment's live data: the database
# (iso-quality.db with its -wal and -shm files), the copies `npm run backup`
# makes, and directory-link.csv. Leave it blank to keep the data in server/data
# inside the code folder.
#
# Set it to keep the data outside the code folder, where a pull or a fresh clone
# cannot touch it and one backup of the data folder covers every app, e.g.
#     DATA_DIR=E:\Apps\data\iso
# Write the path without quotes. A relative path is taken from the server folder.
#
# Once it is set, the server refuses to start if the database is not in that
# folder (or is empty), rather than create a new empty one. Move the data first,
# with the server stopped: iso-quality.db together with iso-quality.db-wal and
# iso-quality.db-shm. The -wal file holds the newest changes, so the server also
# refuses when a -wal with newer changes, or a newer database, is still in
# server/data.
DATA_DIR=

# Overrides the database file alone, wherever DATA_DIR points. Leave it blank:
# with DATA_DIR set, a database outside that folder is not in its backup.
DB_PATH=

# ─── Working week ─────────────────────────────────────────────────────────────
# Days that are NOT working days, 0=Sunday … 6=Saturday. Bahrain: Fri + Sat.
# The deadline engine skips these and every date inside a public holiday.
WEEKEND_DAYS=5,6

